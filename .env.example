# ---------------------------------------------------------------------------
# Atlas — نمونه‌ی متغیرهای محیطی
#
# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید:
#     cp .env.example .env        (Windows: copy .env.example .env)
#
# فایل .env هرگز نباید در گیت ثبت شود؛ فقط همین فایل نمونه ثبت می‌شود.
# ---------------------------------------------------------------------------

# --- پایه ---------------------------------------------------------------
# در سرور حتماً False بماند.
DEBUG=True

# کلید یکتا و محرمانه. برای ساخت یک کلید تازه:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-generated-secret-key

# دامنه‌های مجاز، با کاما جدا شوند. در حالت DEBUG خالی بماند اشکالی ندارد.
ALLOWED_HOSTS=example.com,www.example.com

# برای فرم‌های POST روی HTTPS لازم است (با پروتکل بنویسید).
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# آدرس عمومی سایت — مبنای ساخت QR کد. فردا فقط همین را عوض کنید.
SITE_URL=http://127.0.0.1:8000

# --- پایگاه داده (PostgreSQL) -------------------------------------------
DB_NAME=atlas_db
DB_USER=atlas_user
DB_PASSWORD=replace-me-with-the-database-password
DB_HOST=localhost
DB_PORT=5432
# مدت نگهداری اتصال (ثانیه)؛ خالی بگذارید تا پیش‌فرض ۶۰ اعمال شود.
DB_CONN_MAX_AGE=60

# --- ایمیل ---------------------------------------------------------------
# پیش‌فرض، ایمیل‌ها در کنسول چاپ می‌شوند. برای ارسال واقعی، خط SMTP را باز کنید.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-me-with-the-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- امنیت (فقط وقتی DEBUG=False است اعمال می‌شود) ----------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
