# ---------------------------------------------------------------------------
# Atlas — production environment for https://www.atlas-aim.com
#
#   cp .env.production.example .env      then replace every "replace-me" value.
#
# .env is never committed to git. Keep it only on the server.
# ---------------------------------------------------------------------------

DEBUG=False

# Generate a fresh key on the server:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-long-random-secret-key

ALLOWED_HOSTS=www.atlas-aim.com,atlas-aim.com
CSRF_TRUSTED_ORIGINS=https://www.atlas-aim.com,https://atlas-aim.com
SITE_URL=https://www.atlas-aim.com

# --- Database ----------------------------------------------------------------
# DB_ENGINE: "mysql" for MariaDB/MySQL (the live cPanel host) or "postgresql" (Docker).
# If omitted, port 3306 selects MariaDB and anything else PostgreSQL.
#
# cPanel host (MariaDB 10.6):
#   DB_ENGINE=mysql   DB_HOST=localhost   DB_PORT=3306
# Docker: DB_ENGINE=postgresql (DB_HOST/DB_PORT are set by docker-compose).
DB_ENGINE=postgresql
DB_NAME=atlas
DB_USER=atlas
DB_PASSWORD=replace-me-with-a-strong-database-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- HTTPS -------------------------------------------------------------------
# True once the SSL certificate is installed (redirect to https, secure cookies, HSTS).
# Set False ONLY for a temporary plain-HTTP test before the certificate exists.
SECURE_SSL_REDIRECT=True
# Start with 1 hour; raise to 31536000 (1 year) after HTTPS has been verified.
SECURE_HSTS_SECONDS=3600

# --- Email (contact-form notifications) ---------------------------------------
# Leave the console backend to only store messages in the admin panel.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.atlas-aim.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@atlas-aim.com
EMAIL_HOST_PASSWORD=replace-me-with-the-mailbox-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=info@atlas-aim.com
